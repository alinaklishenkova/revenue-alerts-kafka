{
  "name": "purchase-connector",
  "config": {
    "connector.class": "io.confluent.kafka.connect.datagen.DatagenConnector",
    "kafka.topic": "purchases",
    "schema.string": "{\"namespace\":\"ksql\",\"name\":\"purchase\",\"type\":\"record\",\"fields\":[{\"name\":\"id\",\"type\":{\"type\":\"long\",\"arg.properties\":{\"iteration\":{\"start\":0}}}},{\"name\":\"quantity\",\"type\":{\"type\":\"long\",\"arg.properties\":{\"range\":{\"min\":1,\"max\":11}}}},{\"name\":\"productid\",\"type\":{\"type\":\"long\",\"arg.properties\":{\"range\":{\"min\":0,\"max\":100}}}}]}",
    "key.converter": "org.apache.kafka.connect.storage.StringConverter",
    "value.converter": "io.confluent.connect.avro.AvroConverter",
    "value.converter.schema.registry.url": "http://schema-registry:8081",
    "key.field": "id",
    "max.interval": 100,
    "iterations": 1000000,
    "tasks.max": "1"
  }
}